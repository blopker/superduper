  "fixed_sql": [
    {
      "name": "bikes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bikes\" (\"device_id\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"advertised_name\" TEXT NOT NULL, \"protocol\" TEXT NOT NULL, \"region\" TEXT NULL, \"color_key\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"created_at_ms\" INTEGER NOT NULL, \"updated_at_ms\" INTEGER NOT NULL, \"last_connected_at_ms\" INTEGER NULL, \"module_serial\" TEXT NULL, \"odometer_meters\" INTEGER NULL, \"odometer_read_at_ms\" INTEGER NULL, PRIMARY KEY (\"device_id\"), CHECK (length(device_id) > 0), CHECK (length(display_name) > 0), CHECK (length(advertised_name) > 0), CHECK (protocol IN ('v1', 'v2')), CHECK ((protocol = 'v1' AND region IS NOT NULL AND region IN ('us', 'eu')) OR (protocol = 'v2' AND region IS NULL)), CHECK (length(color_key) > 0));"
        }
      ]
    },
    {
      "name": "bike_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bike_preferences\" (\"device_id\" TEXT NOT NULL REFERENCES bikes (device_id) ON DELETE CASCADE, \"desired_light\" INTEGER NOT NULL CHECK (\"desired_light\" IN (0, 1)), \"desired_mode\" INTEGER NOT NULL, \"desired_assist\" INTEGER NOT NULL, \"keep_light\" INTEGER NOT NULL CHECK (\"keep_light\" IN (0, 1)), \"keep_mode\" INTEGER NOT NULL CHECK (\"keep_mode\" IN (0, 1)), \"keep_assist\" INTEGER NOT NULL CHECK (\"keep_assist\" IN (0, 1)), \"background_requested\" INTEGER NOT NULL CHECK (\"background_requested\" IN (0, 1)), \"background_consent_version\" INTEGER NOT NULL, PRIMARY KEY (\"device_id\"), CHECK (desired_mode BETWEEN 0 AND 3), CHECK (desired_assist BETWEEN 0 AND 4), CHECK (background_consent_version >= 0));"
        }
      ]
    },
    {
      "name": "bike_versions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bike_versions\" (\"device_id\" TEXT NOT NULL REFERENCES bikes (device_id) ON DELETE CASCADE, \"hardware_revision\" TEXT NOT NULL, \"firmware_revision\" TEXT NOT NULL, \"software_revision\" TEXT NOT NULL, \"stm_firmware_version\" INTEGER NOT NULL, \"controller_variant\" INTEGER NOT NULL, \"bootloader_handoff\" INTEGER NOT NULL, \"motor_controller_version\" INTEGER NOT NULL, \"bms_version\" INTEGER NOT NULL, \"read_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"device_id\"), CHECK (length(hardware_revision) > 0), CHECK (length(firmware_revision) > 0), CHECK (length(software_revision) > 0), CHECK (stm_firmware_version BETWEEN 0 AND 16777215), CHECK (controller_variant BETWEEN 0 AND 65535), CHECK (bootloader_handoff BETWEEN 0 AND 255), CHECK (motor_controller_version BETWEEN 0 AND 4294967295), CHECK (bms_version BETWEEN 0 AND 4294967295));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"singleton_id\" INTEGER NOT NULL, \"active_bike_id\" TEXT NULL REFERENCES bikes (device_id) ON DELETE SET NULL, \"last_viewed_bike_id\" TEXT NULL REFERENCES bikes (device_id) ON DELETE SET NULL, \"migration_notice_pending\" INTEGER NOT NULL CHECK (\"migration_notice_pending\" IN (0, 1)), PRIMARY KEY (\"singleton_id\"), CHECK (singleton_id = 1));"
        }
      ]
    },
    {
      "name": "data_imports",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"data_imports\" (\"import_key\" TEXT NOT NULL, \"outcome\" TEXT NOT NULL, \"completed_at_ms\" INTEGER NOT NULL, \"bikes_imported\" INTEGER NOT NULL, \"warnings_json\" TEXT NOT NULL, PRIMARY KEY (\"import_key\"), CHECK (outcome IN ('completed', 'no_source', 'skipped_by_user')), CHECK (bikes_imported >= 0));"
        }
      ]
    }
  ]
}